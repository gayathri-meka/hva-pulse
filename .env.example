NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Email (Gmail API via OAuth) — for templated mail-merge campaigns.
# Create an OAuth 2.0 Web client in Google Cloud with the gmail.send +
# userinfo.email scopes and redirect URI <app-origin>/api/google/callback,
# then connect the sending account under Settings → Email.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
EMAIL_FROM_NAME       # optional display name, e.g. "HyperVerge Academy" (address = the connected account)

# Tech Support tickets — hva-pulse routes reply/close/reopen/edit through the shared Slack edge
HVA_PULSE_EDGE_SECRET=
